{
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/sitemap.xml"
    },
    {
      "source": "/robots.txt",
      "destination": "/robots.txt"
    },
    {
      "source": "/llms.txt",
      "destination": "/llms.txt"
    },
    {
      "source": "/((?!sitemap\\.xml|robots\\.txt|llms\\.txt).*)",
      "destination": "/index.html"
    }
  ]
}
